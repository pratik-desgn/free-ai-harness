# The user signs into the harness once; provider credentials stay server-side.
HARNESS_LOGIN_PASSWORD=
# 32-byte hex key used only to encrypt provider credentials at rest.
HARNESS_VAULT_KEY=
# Optional machine-to-machine key. Generate with: openssl rand -hex 32
HARNESS_API_KEY=
HARNESS_PORT=8790
HARNESS_HOST=127.0.0.1
# Required when serving through a public reverse proxy, for example https://ai.example.com
HARNESS_PUBLIC_ORIGIN=
HARNESS_TRUST_PROXY=false
HARNESS_SECURE_COOKIES=false
HARNESS_DATA_DIR=.harness
HARNESS_SESSION_DAYS=30
HARNESS_MAX_AGENT_STEPS=12
HARNESS_WORKSPACE_ROOT=/home/edith/Projects/harness-workspace

# Connect any subset. Keys remain local and are never returned by the API.
NVIDIA_API_KEY=
ZAI_API_KEY=
HF_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# Optional escape hatch for any other OpenAI-compatible free endpoint.
CUSTOM_PROVIDER_LABEL=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODELS=
CUSTOM_DATA_MAY_TRAIN=true

# Routing controls
HARNESS_FREE_ONLY=true
HARNESS_ALLOW_TRAINING_DATA=false
HARNESS_REQUEST_TIMEOUT_MS=120000
HARNESS_CACHE_TTL_MS=3600000
HARNESS_REQUESTS_PER_MINUTE=120
HARNESS_JSON_BODY_LIMIT=2097152
HARNESS_UPLOAD_BODY_LIMIT=10485760
HARNESS_MAX_OUTPUT_TOKENS=8192
HARNESS_MAX_UPSTREAM_RESPONSE_BYTES=16777216
HARNESS_DAILY_TOKEN_BUDGET=5000000
HARNESS_MAX_ACTIVE_RUNS_PER_USER=3
HARNESS_MAX_GLOBAL_ACTIVE_RUNS=50
HARNESS_MAX_USER_RUNTIMES=500
HARNESS_RETENTION_DAYS=30
HARNESS_SHARE_OPERATOR_CAPACITY=false
HARNESS_ALLOW_USER_NETWORK_TOOLS=true
HARNESS_ALLOW_USER_WORKSPACE_TOOLS=true
# Never enables in-process code execution in production.
HARNESS_ALLOW_USER_CODE_EXECUTION=false

# Always-available local fallback. The harness starts Ollama when installed.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
