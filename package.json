{
  "name": "free-ai-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quota-aware, OpenAI-compatible router for legitimate free AI provider tiers.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
