# Compose-only settings. Copy to deploy/.env and keep mode 0600.
HARNESS_DOMAIN=ai.example.com
ACME_EMAIL=ops@example.com
HARNESS_IMAGE=free-ai-harness:local
HARNESS_ENV_FILE=.env

# Runtime secrets and settings. Compose reads this file via HARNESS_ENV_FILE.
# Generate independent values with: openssl rand -hex 32
# REPLACE_ME values deliberately fail production startup; never deploy defaults.
HARNESS_VAULT_KEY=REPLACE_ME
HARNESS_API_KEY=REPLACE_ME
HARNESS_LOGIN_PASSWORD=REPLACE_ME

HARNESS_SESSION_DAYS=7
HARNESS_MAX_AGENT_STEPS=12
HARNESS_FREE_ONLY=true
HARNESS_ALLOW_TRAINING_DATA=false
HARNESS_SHARE_OPERATOR_CAPACITY=false
HARNESS_REQUEST_TIMEOUT_MS=120000
HARNESS_CACHE_TTL_MS=3600000
HARNESS_REQUESTS_PER_MINUTE=120
HARNESS_MAX_ACTIVE_RUNS_PER_USER=3
HARNESS_MAX_GLOBAL_ACTIVE_RUNS=50
HARNESS_MAX_USER_RUNTIMES=500
HARNESS_RETENTION_DAYS=30
HARNESS_JSON_BODY_LIMIT=2097152
HARNESS_UPLOAD_BODY_LIMIT=10485760
HARNESS_MAX_OUTPUT_TOKENS=8192
HARNESS_MAX_UPSTREAM_RESPONSE_BYTES=16777216
# Rolling 24-hour safety ceiling; accurate only when the provider reports usage.
HARNESS_DAILY_TOKEN_BUDGET=5000000
HARNESS_ALLOW_USER_NETWORK_TOOLS=true
HARNESS_ALLOW_USER_WORKSPACE_TOOLS=true
# Deliberately ignored in production; code execution requires a separate sandbox service.
HARNESS_ALLOW_USER_CODE_EXECUTION=false

# Add only the provider credentials you intentionally want operator access to.
NVIDIA_API_KEY=
ZAI_API_KEY=
HF_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
