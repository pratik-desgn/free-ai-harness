[Unit]
Description=Free AI Harness production Compose stack
Documentation=file:/opt/free-ai-harness/deploy/OPERATIONS.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/free-ai-harness
EnvironmentFile=/opt/free-ai-harness/deploy/.env
ExecStartPre=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml config --quiet
ExecStartPre=/usr/bin/env REQUIRE_IMMUTABLE_IMAGES=true /usr/bin/node /opt/free-ai-harness/scripts/validate-deployment.mjs /opt/free-ai-harness/deploy/.env
ExecStartPre=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml pull
ExecStart=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --no-build --remove-orphans
ExecReload=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml pull
ExecReload=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --no-build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy/.env -f deploy/docker-compose.yml down
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
